; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SleeperTrain"
run/main_scene="res://source/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

Globals="*res://source/autoloads/globals.gd"
SignalBus="*res://source/autoloads/signal_bus.gd"
CharacterRegistry="*res://source/autoloads/character_registry.gd"
BuildingGrid="*res://source/autoloads/building_grid.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[gui]

theme/default_font_multichannel_signed_distance_field=true

